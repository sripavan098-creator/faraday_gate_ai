# Faraday local runtime state.
# The whole directory is local-only: it holds the active config, the audit
# chain (which embeds repository paths, hashes, and redaction metadata), and
# cached policy copies. None of it belongs in a public repository.
.faraday/

# Local release/security reports (scan output, proof reports). Sanitized
# evidence can be committed deliberately with `git add -f`.
reports/

# Environment files
.env
.env.*

# Keep the fake demo env so the sample repository stays runnable.
!.env.fake
